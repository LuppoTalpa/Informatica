<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<!-- NOTA: Abbiamo aggiunto stylesheets="@style.css" qui sotto -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="talpa.javafx5_slotmachine.SlotController"
            stylesheets="@style.css"
            style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e);">

    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Apri" onAction="#onApri"/>
                <MenuItem text="Salva" onAction="#onSalva"/>
            </Menu>
            <Menu text="Statistiche">
                <MenuItem text="Mostra" onAction="#onMostraStatistiche"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="Info" onAction="#onHelp"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <VBox spacing="25.0" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Slot Machine Reels -->
            <HBox spacing="15.0" alignment="CENTER"
                  style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: rgba(255, 215, 0, 0.3); -fx-border-width: 2; -fx-border-radius: 15;">
                <effect>
                    <DropShadow color="rgba(0, 0, 0, 0.5)" radius="15" offsetY="5"/>
                </effect>

                <ImageView fx:id="iv1" fitWidth="120.0" fitHeight="120.0" preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, rgba(255, 215, 0, 0.4), 10, 0.5, 0, 0);">
                    <Image url="@img/arancio.jpg"/>
                </ImageView>

                <ImageView fx:id="iv2" fitWidth="120.0" fitHeight="120.0" preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, rgba(255, 215, 0, 0.4), 10, 0.5, 0, 0);">
                    <Image url="@img/banane.jpg"/>
                </ImageView>

                <ImageView fx:id="iv3" fitWidth="120.0" fitHeight="120.0" preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, rgba(255, 215, 0, 0.4), 10, 0.5, 0, 0);">
                    <Image url="@img/ciliegie.jpg"/>
                </ImageView>
            </HBox>

            <!-- Spin Button -->
            <Button text="GIRA"
                    onAction="#onSpinClick"
                    style="-fx-background-color: linear-gradient(#ff4444, #cc0000); -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 100px; -fx-min-height: 100px; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.6)" radius="10" offsetY="5"/>
                </effect>
            </Button>

            <!-- Feedback Image (Win/Lose) -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fx:id="ivEsito" fitWidth="80.0" fitHeight="80.0" preserveRatio="true">
                    <!-- Immagine vuota o default all'inizio -->
                </ImageView>
                <Label fx:id="lblMessaggio" text="" style="-fx-text-fill: #ffd700; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </VBox>

        </VBox>
    </center>

    <right>
        <!-- ListBox per Statistiche -->
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: rgba(0,0,0,0.2);">
            <Label text="Vittorie" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            <ListView fx:id="lstVittorie" prefWidth="200" prefHeight="400"/>
        </VBox>
    </right>

</BorderPane>
