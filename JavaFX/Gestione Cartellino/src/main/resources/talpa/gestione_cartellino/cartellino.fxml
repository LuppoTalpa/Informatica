<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<HBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="talpa.gestione_cartellino.Controller">
   <children>
       <VBox alignment="CENTER" prefHeight="240.0" prefWidth="200.0" spacing="20.0">
           <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
           </padding>
           <ListView fx:id="log" prefHeight="200.0" prefWidth="200.0" />
       </VBox>
      <VBox alignment="CENTER" prefHeight="240.0" prefWidth="320.0" spacing="20.0">
          <padding>
              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
          </padding>
         <Label text="Nome dipendente" />
         <TextField fx:id="nome" />
         <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
            <children>
                <Button fx:id="ingresso" onAction="#onClickIngresso" text="Ingresso" textFill="#00ab1c" />
               <Button fx:id="uscita" mnemonicParsing="false" onAction="#onClickUscita" text="Uscita" textFill="RED" />
            </children>
         </HBox>
         <ListView fx:id="presenti" prefHeight="200.0" prefWidth="200.0" />
      </VBox>
   </children>
</HBox>
